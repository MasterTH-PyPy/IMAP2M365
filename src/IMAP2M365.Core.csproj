<Project Sdk="Microsoft.NET.Sdk">

  <!-- Engine-Bibliothek: plattformneutral (net10.0), damit testbar.
       Die WinForms-GUI kommt als separates net10.0-windows-Projekt obendrauf
       und referenziert diese DLL. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>IMAP2M365</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.*" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.*" />
    <!-- Graph-Target (zweiter Provider): aktivieren, wenn du GraphTarget baust
    <PackageReference Include="Microsoft.Graph" Version="5.*" />
    -->
  </ItemGroup>

</Project>
