<Project Sdk="Microsoft.NET.Sdk">

  <!-- Engine-Bibliothek: plattformneutral (net10.0), damit testbar.
       Die WinForms-GUI (src/Gui) referenziert diese DLL. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>IMAP2M365</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.*" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.*" />
    <!-- app-only Graph-Token (GraphTarget nutzt REST, kein Microsoft.Graph/Kiota) -->
    <PackageReference Include="Azure.Identity" Version="1.*" />
  </ItemGroup>

</Project>
