<Project Sdk="Microsoft.NET.Sdk">

  <!-- Generator-Tool für den Lizenzgeber (Rudolf), WinForms-GUI. Hält den PRIVATEN Schlüssel.
       Referenziert die Lizenz-Typen aus Core. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>IMAP2M365.LicenseGen</RootNamespace>
    <AssemblyName>IMAP2M365.LicenseGen</AssemblyName>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>..\..\src\Gui\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\IMAP2M365.Core.csproj" />
  </ItemGroup>

</Project>
