<Project Sdk="Microsoft.NET.Sdk">

  <!-- Generator-Tool für den Lizenzgeber (Rudolf). Hält den PRIVATEN Schlüssel.
       Plattformneutral (Konsole), referenziert die Lizenz-Typen aus Core. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>IMAP2M365.LicenseGen</RootNamespace>
    <AssemblyName>IMAP2M365.LicenseGen</AssemblyName>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\IMAP2M365.Core.csproj" />
  </ItemGroup>

</Project>
